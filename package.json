{
	"name": "janusz-v2",
	"description": "Multifunctional Chat Bot - Janusz V2",
	"version": "2.1.0",
	"main": "server.ts",
	"author": "Fun Maker",
	"repository": "https://github.com/funmaker/janusz-v2",
	"engines": {
		"node": ">=22.12.0",
		"npm": ">=7.0.0"
	},
	"scripts": {
		"start": "rm -rf build && webpack --config webpack/server.dev.ts",
		"start:prod": "cd dist && npm start",
		"build:prod": "mkdir -p dist && npm-run-all build:prod-*",
		"build:prod-server": "webpack --config webpack/server.prod.ts",
		"build:prod-client": "webpack --config webpack/client.prod.ts",
		"build:prod-static": "cp -rL static dist/ && cp -rL sounds/sounds dist/",
		"build:prod-package": "babel-node --extensions .ts webpack/package.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint --max-warnings 0",
		"lint-fix": "eslint --fix"
	},
	"dependencies": {
